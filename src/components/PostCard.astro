---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data, id } = post;

// 从 id 生成 slug (移除 .md 扩展名)
const slug = id.replace(/\.md$/, '');

const formattedDate = new Date(data.publishedAt).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});

const formattedViews = data.views 
  ? data.views >= 1000 
    ? `${(data.views / 1000).toFixed(1)}K`
    : data.views.toString()
  : null;

// 生成摘要 - 从 Markdown body 提取纯文本
const excerpt = post.body 
  ? post.body.slice(0, 150).replace(/[#*_`]/g, '').trim() + '...'
  : '点击阅读更多...';
---

<article class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden hover:shadow-md transition-shadow duration-200">
  <a href={`/post/${slug}/`} class="block">
    {data.image && (
      <div class="relative aspect-video w-full overflow-hidden">
        <img
          src={data.image}
          alt={data.title}
          class="w-full h-full object-cover hover:scale-105 transition-transform duration-200"
          loading="lazy"
        />
      </div>
    )}
    
    <div class="p-4">
      <div class="flex items-center gap-2 mb-3 flex-wrap">
        {data.tags?.slice(0, 3).map((tag: string) => (
          <span class="px-2 py-0.5 text-xs font-medium bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-full">
            #{tag}
          </span>
        ))}
        <time class="text-xs text-gray-500 dark:text-gray-400 ml-auto">
          {formattedDate}
        </time>
      </div>
      
      <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-2 line-clamp-2">
        {data.title}
      </h2>
      
      <p class="text-gray-600 dark:text-gray-300 text-sm mb-3 line-clamp-3">
        {excerpt}
      </p>
      
      <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400 pt-3 border-t border-gray-100 dark:border-gray-700">
        <div class="flex items-center gap-3">
          {formattedViews && (
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              {formattedViews}
            </span>
          )}
          {data.comments !== undefined && (
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              {data.comments}
            </span>
          )}
        </div>
        <span class="text-blue-600 dark:text-blue-400 font-medium">
          阅读 →
        </span>
      </div>
    </div>
  </a>
</article>
