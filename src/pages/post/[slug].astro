---
import ChannelLayout from '../../layouts/ChannelLayout.astro';
import PostCard from '../../components/PostCard.astro';
import PostReadingTools from '../../components/PostReadingTools.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { channelConfig } from '../../config/channel';

export interface Props {
  post: CollectionEntry<'posts'>;
}

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts.map((post: CollectionEntry<'posts'>) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;
---

<ChannelLayout
  pageTitle={data.title}
  channelName={channelConfig.name}
  channelUsername={channelConfig.username}
  subscribers={channelConfig.subscribers}
  description={channelConfig.description}
  githubUrl={channelConfig.githubUrl}
>
  <div data-post-article>
    <PostCard post={post} Content={Content} />
  </div>

  <PostReadingTools />
</ChannelLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('main-scroll-container');
    if (container) {
      container.scrollTop = 0;
    }
  });
</script>
