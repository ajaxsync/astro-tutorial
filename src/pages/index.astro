---
import ChannelLayout from '../layouts/ChannelLayout.astro';
import PostFeed from '../components/PostFeed.astro';
import { channelConfig } from '../config/channel';
import { getPublishedPosts, prepareGroupedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const groupedPosts = await prepareGroupedPosts(posts);
---

<ChannelLayout
  pageTitle="首页"
  channelName={channelConfig.name}
  channelUsername={channelConfig.username}
  subscribers={channelConfig.subscribers}
  description={channelConfig.description}
  postsCount={posts.length}
  githubUrl={channelConfig.githubUrl}
>
  <PostFeed
    groupedPosts={groupedPosts}
    postsCount={posts.length}
    emptyMessage="暂无消息，敬请期待"
  />
</ChannelLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('main-scroll-container');
    if (container) {
      container.scrollTop = container.scrollHeight;
    }
  });
</script>
