---
import ChannelLayout from '../layouts/ChannelLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const posts = await getCollection('posts', ({ data }: { data: any }) => {
  return !data.draft;
});

posts.sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => {
  return new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime();
});

const pageTitle = '首页';
const channelName = '科技前沿';
const subscribers = 12500;
---

<ChannelLayout pageTitle={pageTitle} channelName={channelName} subscribers={subscribers}>
  <div class="space-y-4">
    {posts.map((post: CollectionEntry<'posts'>) => (
      <PostCard post={post} />
    ))}
  </div>
  
  {posts.length === 0 && (
    <div class="text-center py-12">
      <svg class="w-16 h-16 mx-auto text-gray-300 dark:text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
      </svg>
      <p class="text-gray-500 dark:text-gray-400">暂无消息，敬请期待</p>
    </div>
  )}
</ChannelLayout>
